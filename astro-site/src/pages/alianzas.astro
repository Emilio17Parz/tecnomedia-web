---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = "Alianzas | TecnoMedia";
const description = "Alianzas tecnológicas de TecnoMedia.";
const page = "partners";
---

<BaseLayout {title} {description} {page}>
<main><section class="page-hero"><div class="mx-auto max-w-7xl px-5 lg:px-8"><span class="eyebrow reveal">Alianzas estratégicas</span><h1 class="section-title mt-4 max-w-5xl reveal">Tecnología líder respaldada por integración especializada.</h1><p class="section-copy mt-5 max-w-3xl reveal">Trabajamos con fabricantes y plataformas reconocidas para construir soluciones completas alrededor de observabilidad, DevSecOps y seguridad.</p></div></section><section class="py-16 sm:py-20">
  <div class="mx-auto max-w-7xl px-5 lg:px-8">
    <div class="partners-grid grid grid-cols-2 gap-4 md:grid-cols-3 lg:grid-cols-4">
        <a class="partner-card reveal" href="https://www.appdynamics.com/" target="_blank" rel="noopener noreferrer" aria-label="Abrir sitio de AppDynamics">
          <img src="/assets/logos/partners/appdynamics.png" alt="AppDynamics" loading="lazy">
          <span>AppDynamics</span>
        </a>
        <a class="partner-card reveal" href="https://www.harness.io/" target="_blank" rel="noopener noreferrer" aria-label="Abrir sitio de Harness">
          <img src="/assets/logos/partners/harness.jpg" alt="Harness" loading="lazy">
          <span>Harness</span>
        </a>
        <a class="partner-card reveal" href="https://www.veracode.com/" target="_blank" rel="noopener noreferrer" aria-label="Abrir sitio de Veracode">
          <img src="/assets/logos/partners/veracode.jpg" alt="Veracode" loading="lazy">
          <span>Veracode</span>
        </a>
        <a class="partner-card reveal" href="https://www.netscout.com/" target="_blank" rel="noopener noreferrer" aria-label="Abrir sitio de NETSCOUT">
          <img src="/assets/logos/partners/netscout.jpg" alt="NETSCOUT" loading="lazy">
          <span>NETSCOUT</span>
        </a>
        <a class="partner-card reveal" href="https://cloud.google.com/apigee" target="_blank" rel="noopener noreferrer" aria-label="Abrir sitio de Google Apigee">
          <img src="/assets/logos/partners/apigee.png" alt="Google Apigee" loading="lazy">
          <span>Google Apigee</span>
        </a>
        <a class="partner-card reveal" href="https://www.datadoghq.com/" target="_blank" rel="noopener noreferrer" aria-label="Abrir sitio de Datadog">
          <img src="/assets/logos/partners/datadog.jpg" alt="Datadog" loading="lazy">
          <span>Datadog</span>
        </a>
        <a class="partner-card reveal" href="https://www.cyberark.com/" target="_blank" rel="noopener noreferrer" aria-label="Abrir sitio de CyberArk">
          <img src="/assets/logos/partners/cyberark.jpeg" alt="CyberArk" loading="lazy">
          <span>CyberArk</span>
        </a>
        <a class="partner-card reveal" href="https://solace.com/" target="_blank" rel="noopener noreferrer" aria-label="Abrir sitio de Solace">
          <img src="/assets/logos/partners/solace.png" alt="Solace" loading="lazy">
          <span>Solace</span>
        </a>
        <a class="partner-card reveal" href="https://www.splunk.com/" target="_blank" rel="noopener noreferrer" aria-label="Abrir sitio de Splunk">
          <img src="/assets/logos/partners/splunk.svg" alt="Splunk" loading="lazy">
          <span>Splunk</span>
        </a>
        <a class="partner-card reveal" href="https://grafana.com/" target="_blank" rel="noopener noreferrer" aria-label="Abrir sitio de Grafana">
          <img src="/assets/logos/partners/grafana.svg" alt="Grafana" loading="lazy">
          <span>Grafana</span>
        </a>
        <a class="partner-card reveal" href="https://www.aikido.dev/" target="_blank" rel="noopener noreferrer" aria-label="Abrir sitio de Aikido">
          <img src="/assets/logos/partners/aikido.svg" alt="Aikido" loading="lazy">
          <span>Aikido</span>
        </a>
    </div>
  </div>
</section></main>
</BaseLayout>
