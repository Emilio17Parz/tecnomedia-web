---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = "Servicio administrado de Observabilidad | TecnoMedia";
const description = "Visibilidad de extremo a extremo para mejorar las operaciones de TI y entender rápidamente el comportamiento de servicios y aplicaciones.";
const page = "solutions";
---

<BaseLayout {title} {description} {page}>
<main><section class="page-hero"><div class="mx-auto grid max-w-7xl items-center gap-10 px-5 lg:grid-cols-2 lg:px-8"><div class="text-left reveal"><span class="eyebrow">Observability Experts</span><h1 class="mt-4 text-5xl font-extrabold tracking-tight sm:text-6xl">Servicio administrado de Observabilidad</h1><p class="section-copy mt-5 text-lg">Visibilidad de extremo a extremo para mejorar las operaciones de TI y entender rápidamente el comportamiento de servicios y aplicaciones.</p><a href="contacto.html" class="btn-primary mt-7">Solicitar asesoría</a></div><div class="relative min-h-80 reveal" aria-hidden="true"><div class="orbit orbit-md"></div><div class="orbit orbit-sm"></div><div class="core-mark">◉</div></div></div></section><section class="py-24 sm:py-28"><div class="mx-auto grid max-w-7xl gap-12 px-5 lg:grid-cols-2 lg:px-8"><div class="text-left reveal"><span class="eyebrow">Capacidades</span><h2 class="section-title mt-4">Convierte telemetría en decisiones operativas.</h2><ul class="check-list mt-8"><li>Monitoreo de experiencia digital, aplicaciones, infraestructura y servicios.</li><li>Correlación de señales para acelerar el análisis de causa raíz.</li><li>Tableros operativos y ejecutivos centrados en disponibilidad, rendimiento y experiencia.</li><li>Automatización y analítica para evolucionar de un enfoque reactivo a uno proactivo.</li></ul></div><div class="dark-panel reveal"><span class="feature-icon">◉</span><h3>Enfoque TecnoMedia</h3><p>Integramos la observabilidad alrededor de la operación: qué está pasando, por qué pasa, a quién afecta y qué acción conviene tomar.</p><a class="btn-light mt-6" href="contacto.html">Hablar con un experto</a></div></div></section></main>
</BaseLayout>
