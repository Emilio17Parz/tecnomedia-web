---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = "Seguridad para entornos digitales modernos | TecnoMedia";
const description = "Protege accesos, identidades, aplicaciones y datos con controles alineados al riesgo y a la operación.";
const page = "solutions";
---

<BaseLayout {title} {description} {page}>
<main><section class="page-hero"><div class="mx-auto grid max-w-7xl items-center gap-10 px-5 lg:grid-cols-2 lg:px-8"><div class="text-left reveal"><span class="eyebrow">Ciberseguridad</span><h1 class="mt-4 text-5xl font-extrabold tracking-tight sm:text-6xl">Seguridad para entornos digitales modernos</h1><p class="section-copy mt-5 text-lg">Protege accesos, identidades, aplicaciones y datos con controles alineados al riesgo y a la operación.</p><a href="contacto.html" class="btn-primary mt-7">Solicitar asesoría</a></div><div class="relative min-h-80 reveal" aria-hidden="true"><div class="orbit orbit-md"></div><div class="orbit orbit-sm"></div><div class="core-mark">◇</div></div></div></section><section class="py-24 sm:py-28"><div class="mx-auto grid max-w-7xl gap-12 px-5 lg:grid-cols-2 lg:px-8"><div class="text-left reveal"><span class="eyebrow">Capacidades</span><h2 class="section-title mt-4">Reduce superficie de ataque sin frenar al usuario.</h2><ul class="check-list mt-8"><li>Administración y protección de cuentas privilegiadas.</li><li>Acceso seguro a aplicaciones privadas sin depender de VPN tradicional.</li><li>Acceso seguro a Internet con controles de política y reducción de superficie de ataque.</li><li>Gestión de vulnerabilidades, APIs, identidades y controles de acceso.</li></ul></div><div class="dark-panel reveal"><span class="feature-icon">◇</span><h3>Enfoque TecnoMedia</h3><p>Combinamos controles de identidad, acceso y protección de aplicaciones con una visión Zero Trust y de operación empresarial.</p><a class="btn-light mt-6" href="contacto.html">Hablar con un experto</a></div></div></section></main>
</BaseLayout>
