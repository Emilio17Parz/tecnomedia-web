---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = "404 | TecnoMedia";
const description = "Página no encontrada.";
const page = "";
---

<BaseLayout {title} {description} {page}>
<main class="grid min-h-screen place-items-center px-5 pt-24"><div class="max-w-2xl text-left"><span class="eyebrow">Error 404</span><h1 class="mt-4 text-6xl font-extrabold tracking-tight">Esta página no existe.</h1><p class="section-copy mt-5">Regresa al inicio o contáctanos si estabas buscando información específica.</p><a class="btn-primary mt-7" href="index.html">Volver al inicio</a></div></main>
</BaseLayout>
